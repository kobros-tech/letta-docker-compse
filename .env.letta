# PostgreSQL settings
LETTA_PG_USER=letta
LETTA_PG_PASSWORD=letta
LETTA_PG_DB=letta
LETTA_DB_HOST=letta_db
LETTA_PG_PORT=5432
LETTA_PG_URI=postgresql://letta:letta@letta_db:5432/letta

# Disable OpenAI / Anthropic (optional but recommended)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Use local Ollama container
OLLAMA_BASE_URL=http://ollama:11434

# Debug
LETTA_DEBUG=True
